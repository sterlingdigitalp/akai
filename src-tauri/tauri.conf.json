{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Woodshed",
  "version": "0.1.0",
  "identifier": "com.sterlingdigital.woodshed",
  "build": {
    "beforeDevCommand": "npm run dev -- --port 1420 --strictPort",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:native",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Woodshed",
        "width": 1320,
        "height": 980,
        "minWidth": 1024,
        "minHeight": 780,
        "backgroundColor": "#100d0c"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: asset: http://asset.localhost; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "resources": {
      "target/build-provenance.json": "build-provenance.json"
    }
  }
}
